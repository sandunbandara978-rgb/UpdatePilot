# ==========================================
# UpdatePilot Environment Configuration Template
# ==========================================

# Database Connection (PostgreSQL)
# Supports Neon, Supabase, Vercel Postgres, or local PostgreSQL instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/updatepilot?schema=public"

# Authentication & Session Security
# Generate high-entropy secret using: openssl rand -base64 32
SESSION_SECRET="updatepilot-super-secure-production-secret-replace-in-prod"
DEFAULT_ADMIN_PASSWORD="Password123!"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Windows Agent Configuration
# Interval in seconds between heartbeat / job polls
NEXT_PUBLIC_AGENT_POLL_INTERVAL=15
PAIRING_CODE_TTL_MINUTES=10

# Optional: Public URL for compiled Windows installer (.exe) when hosted on Vercel
# e.g. https://github.com/your-org/UpdatePilot/releases/download/v1.0.0/UpdatePilot-Agent-Setup-1.0.0-x64.exe
INSTALLER_DOWNLOAD_URL=""

# Security & Rate Limiting
MAX_PAIRING_ATTEMPTS_PER_IP=10

# Vulnerability Advisory Feed (NIST NVD API v2)
NVD_API_URL="https://services.nvd.nist.gov/rest/json/cves/2.0"
